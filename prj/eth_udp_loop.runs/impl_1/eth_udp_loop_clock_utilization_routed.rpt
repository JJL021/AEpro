# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y16 [get_cells u_gmii_to_rgmii/u_rgmii_rx/BUFG_inst]
set_property LOC BUFGCTRL_X0Y0 [get_cells clk_200m_IBUF_BUFG_inst]

# Location of BUFIO Primitives 
set_property LOC BUFIO_X0Y6 [get_cells u_gmii_to_rgmii/u_rgmii_rx/BUFIO_inst]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y97 [get_cells eth_txc_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X0Y28 [get_ports clk_200m]
set_property LOC IOB_X0Y76 [get_ports eth_rxc]

# Clock net "u_gmii_to_rgmii/u_rgmii_rx/gmii_rx_clk" driven by instance "u_gmii_to_rgmii/u_rgmii_rx/BUFG_inst" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_u_gmii_to_rgmii/u_rgmii_rx/gmii_rx_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_u_gmii_to_rgmii/u_rgmii_rx/gmii_rx_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=eth_txc_OBUF_inst} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_gmii_to_rgmii/u_rgmii_rx/gmii_rx_clk"}]]]
resize_pblock [get_pblocks {CLKAG_u_gmii_to_rgmii/u_rgmii_rx/gmii_rx_clk}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "clk_200m_IBUF_BUFG" driven by instance "clk_200m_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_clk_200m_IBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_200m_IBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_200m_IBUF_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_clk_200m_IBUF_BUFG}] -add {CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup
